# --- LLM: Cursor Cloud Agent (current default in config/jobs.yaml) ---
# Dashboard → API Keys: https://cursor.com/dashboard/api
CURSOR_API_KEY=

# --- LLM: OpenAI-compatible (optional, later) ---
# Only needed when job.llm.provider is "openai-compatible"
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- Delivery: Bark (@pocket/bark — multi-device aliases) ---
# BARK_DEVICES=daj,lzx
# BARK_KEY_daj=
# BARK_KEY_lzx=
# Optional shared / per-device server:
BARK_SERVER=https://api.day.app
# BARK_SERVER_daj=https://api.day.app
# Optional custom push icon URL (defaults to assets/icon.png on GitHub):
# BARK_ICON=https://raw.githubusercontent.com/mangomaster13/pocket/master/assets/icon.png
#
# Fallback single device (alias becomes "default"):
# BARK_KEY=

# --- GitHub Pages (full notes; Bark sends title + short teaser + this URL) ---
# Public site origin, no trailing slash:
PAGES_BASE_URL=https://mangomaster13.github.io/pocket

# --- Optional overrides ---
# CONFIG_PATH=config/jobs.yaml
# NOTES_DIR=notes
# INBOX_DIR=inbox
# SITE_DIR=site
# BARK_PRESETS_PATH=config/bark-presets.yaml
