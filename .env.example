# --- LLM: Cursor Cloud Agent (current default in config/jobs.yaml) ---
# Dashboard → API Keys: https://cursor.com/dashboard/api
CURSOR_API_KEY=

# --- LLM: OpenAI-compatible (optional, later) ---
# Only needed when job.llm.provider is "openai-compatible"
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- Delivery: Bark (multi-device aliases) ---
# BARK_DEVICES=daj,lzx
# BARK_KEY_daj=
# BARK_KEY_lzx=
# Optional shared / per-device server:
BARK_SERVER=https://api.day.app
# BARK_SERVER_daj=https://api.day.app
#
# Fallback single device (alias becomes "default"):
# BARK_KEY=

# --- Optional overrides ---
# CONFIG_PATH=config/jobs.yaml
# NOTES_DIR=notes
# INBOX_DIR=inbox
